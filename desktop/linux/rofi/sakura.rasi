/* Light pink adaptation of the glass launcher in https://github.com/d1rshan/dots. */
* {
    font: "Inter 12";
    background-color: transparent;
    text-color: #64283f;
    border-color: rgba(255, 255, 255, 0.75);
    margin: 0;
    padding: 0;
    spacing: 0;
}
window {
    transparency: "real";
    location: center;
    anchor: center;
    width: 540px;
    border: 1px;
    border-radius: 24px;
    background-color: rgba(255, 222, 237, 0.98);
    padding: 12px;
}
mainbox { spacing: 10px; children: [ inputbar, message, listview ]; }
inputbar {
    expand: false;
    background-color: rgba(255, 255, 255, 0.72);
    border: 1px;
    border-radius: 24px;
    padding: 12px 16px;
    children: [ entry ];
}
entry {
    placeholder: "Search apps…";
    placeholder-color: #926476;
    text-color: #542036;
    cursor: text;
}
message { expand: false; padding: 6px; }
textbox { text-color: #855b6b; }
listview {
    lines: 7;
    columns: 1;
    fixed-height: false;
    dynamic: true;
    spacing: 7px;
    scrollbar: false;
}
element {
    orientation: horizontal;
    children: [ element-icon, element-text ];
    background-color: rgba(255, 255, 255, 0.48);
    border: 1px;
    border-radius: 22px;
    padding: 10px 14px;
    spacing: 12px;
}
element normal normal, element alternate normal { background-color: rgba(255, 255, 255, 0.48); }
element selected normal, element selected active {
    background-color: #e993b8;
    text-color: #542036;
}
element normal active { text-color: #a52660; }
element normal urgent, element selected urgent { text-color: #b51d51; }
element-icon { size: 24px; vertical-align: 0.5; background-color: transparent; }
element-text { vertical-align: 0.5; text-color: inherit; background-color: transparent; }
